{
  "name": "proooo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gsd:verify": "npm run lint && npm run build",
    "ralph": "powershell -ExecutionPolicy Bypass -File ./ralph.ps1",
    "ralph:verify": "powershell -ExecutionPolicy Bypass -File ./ralph.ps1 -ValidateOnly",
    "skills:count": "powershell -Command \"(Get-ChildItem -Path .agent/skills/skills -Directory).Count\"",
    "skills:find": "powershell -Command \"Get-ChildItem -Path .agent/skills/skills -Directory -Filter ('*' + $args[0] + '*') | Select-Object -ExpandProperty Name\" --"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jiti": "^2.7.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
